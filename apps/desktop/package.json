{
  "name": "@bum/desktop",
  "productName": "BUM POS KASSA",
  "description": "BUM ERP offline kassa — Windows desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build -c vite.renderer.config.ts",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "dist:win": "pnpm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
