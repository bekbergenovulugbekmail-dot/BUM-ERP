<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulut zaxirasi va qurilmadan qurilmaga ko'chirishda ilova ma'lumoti (sessiya cookie, oflayn navbat,
     keshlangan mijozlar) boshqa qurilmaga o'tmaydi -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
