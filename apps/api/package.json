{
  "name": "@bum/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "start:migrate": "node --disable-warning=ExperimentalWarning dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/cli/seed-bootstrap-admin.ts",
    "db:import-convex": "tsx src/cli/import-convex.ts",
    "db:seed-demo": "tsx src/cli/seed-demo-company.ts",
    "verify:last-pos-sale": "tsx src/cli/verify-last-pos-sale.ts",
    "test:platform-admin": "tsx src/cli/test-platform-admin.ts"
  },
  "dependencies": {
    "@bum/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
