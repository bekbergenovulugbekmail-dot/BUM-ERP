{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "drizzle.config.ts", "vitest.config.ts"],
  // Desktop kassa kodini chaqiradigan uchdan-uchga test — desktop kodi o'z tsconfig'ida tekshiriladi
  "exclude": ["test/desktop-offline-e2e.test.ts"]
}
