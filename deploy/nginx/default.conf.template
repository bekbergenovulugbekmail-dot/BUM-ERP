# nginx rasmiy image'i ishga tushishda ${PORT} va ${API_UPSTREAM} ni muhitdan qo'yadi
# (faqat aniqlangan o'zgaruvchilar — nginx'ning $host, $uri kabilari tegilmaydi).

# Tashqi proksi (Railway edge) bergan protokol saqlanadi — Secure cookie va trustProxy uchun
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen ${PORT};
  listen [::]:${PORT};
  server_tokens off;

  # Mijoz IP: tashqi proksi (Railway edge) qo'shgan OXIRGI X-Forwarded-For qiymati. Mijoz o'zi yuborgan soxta qiymatlar
  # chapda qoladi va hisobga olinmaydi. nginx'ga faqat edge orqali kiriladi, shuning uchun bevosita manba ishonchli.
  # API'ga X-Forwarded-For qayta yoziladi ($remote_addr — aniqlangan mijoz IP), API faqat 1 bosqichga ishonadi.
  set_real_ip_from 0.0.0.0/0;
  set_real_ip_from ::/0;
  real_ip_header X-Forwarded-For;
  real_ip_recursive off;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # API manzili har so'rovda DNS orqali aniqlanadi (o'zgaruvchi orqali proxy_pass): API qayta deploy
  # bo'lib ichki IP o'zgarsa ham, web API'dan oldin ishga tushsa ham nginx yiqilmaydi.
  # NGINX_LOCAL_RESOLVERS — konteynerning /etc/resolv.conf dan (Dockerfile.web dagi ENV yoqadi).
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  # API — bir domen: cookie SameSite muammosiz, CORS kerak emas
  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    # URI qismisiz o'zgaruvchi — asl so'rov yo'li (/api/...) o'zgarmay uzatiladi
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 120s;
    # Mahsulot CSV importi (API bodyLimit 2 MB); fayllar to'g'ridan-to'g'ri S3 ga yuklanadi
    client_max_body_size 3m;
  }

  # Dostavka real-time (WebSocket): Upgrade sarlavhalari va uzoq ulanish (server har 30 s ping yuboradi)
  location = /api/delivery/ws {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
  }

  # Mahsulot rasmi bazaga (fayl saqlash sozlanmagan bo'lsa) — 5 MB gacha rasm to'g'ridan-to'g'ri API'ga
  location ~ ^/api/files/product-image/[^/]+/content$ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 120s;
    client_max_body_size 6m;
  }

  # Desktop kassa relizlari: platforma admini o'rnatuvchini (≈110 MB) yuklaydi, qurilmalar yuklab oladi — katta hajm va
  # uzoq vaqt; yuklash buferlanmaydi (API oqim bilan bazaga yozadi)
  location ~ ^/api/(platform/desktop-releases|pos-device/releases/|pos/devices/installer/) {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 400m;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
  }

  location = /nginx-health {
    access_log off;
    return 200 "ok";
  }

  # Web sahifalar uchun xavfsizlik sarlavhalari. nginx'da location ichidagi add_header server darajasidagini meros
  # olmaydi, shuning uchun har statik location'da takrorlanadi. /api javoblariga qo'shilmaydi — API (helmet) o'zi beradi,
  # ikki marta kelgan X-Frame-Options brauzerlarda bekor hisoblanadi.

  # Vite hash'li fayllar — o'zgarmaydi
  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options "nosniff" always;
  }

  # Service worker va manifest — har doim yangisi
  location ~ ^/(sw\.js|manifest\.webmanifest|manifest\.json)$ {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
  }

  # SPA: /uz/sales kabi yo'llar index.html ga
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
    # Clickjacking: sahifa boshqa saytning iframe'ida ochilmaydi
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # GPS (dostavshik, agent) va kamera (isbot rasmi) — faqat shu sayt; mikrofon, to'lov API'si — yo'q
    add_header Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()" always;
    # CSP: skript faqat shu saytdan (inline va eval yo'q) — XSS bo'lsa ham begona kod ishga tushmaydi (Android ilova ham
    # shu sahifani ochadi). Uslub: React/Leaflet inline style; shrift — Google Fonts; rasm — xarita plitkalari va imzolangan
    # fayl havolalari (https:); ulanish — API (shu sayt), WebSocket va fayl saqlash (https:); iframe — chek oldindan ko'rish
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
  }
}
