# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# "::" IPv4 va IPv6 ni birga tinglaydi; IPv6 yo'q muhitda 0.0.0.0
HOST=::
WEB_ORIGIN=http://localhost:5173

# PostgreSQL — docker-compose bilan lokal
DATABASE_URL=postgresql://postgres:bumerp@localhost:5432/bumerp

# Sessiya — kamida 32 belgi. Yaratish: openssl rand -base64 48
SESSION_SECRET=
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_HOURS=12

# ─── Ixtiyoriy integratsiyalar ────────────────────────────────────────────────
# Eskiz.uz SMS — parol tiklash uchun. Bo'sh bo'lsa SMS o'chiq.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SENDER=4546

# AI moduli
ANTHROPIC_API_KEY=

# S3-mos fayl saqlash — lokal MinIO
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=bum-erp
STORAGE_ACCESS_KEY=bum_minio
STORAGE_SECRET_KEY=bum_minio_local_dev
# MinIO uchun ahamiyatsiz, imzoga kiradi
STORAGE_REGION=us-east-1
# Brauzer ko'radigan manzil (production'da tashqi domen); bo'sh bo'lsa STORAGE_ENDPOINT
STORAGE_PUBLIC_ENDPOINT=

# Bootstrap (ildiz) platforma admini: `pnpm --filter @bum/api db:seed` shu qiymatlardan
# yaratadi yoki yangilaydi. Parolni almashtirish — qiymatni o'zgartirib db:seed ni qayta
# ishga tushirish (eski sessiyalar bekor qilinadi). Bazada faqat argon2id xeshi saqlanadi.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
