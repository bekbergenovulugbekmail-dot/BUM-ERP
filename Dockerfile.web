# BUM ERP frontend (Vite SPA) + nginx.
#
#   docker build -f Dockerfile.web -t bum-erp-web .
#   docker run -p 8080:80 -e API_UPSTREAM=http://host.docker.internal:3000 bum-erp-web
#
# API shu domenning /api yo'lida proksi qilinadi (VITE_API_URL bo'sh): sessiya cookie'si
# app.* va admin.* subdomenlarida bir xil ishlaydi, CORS kerak emas.

FROM node:22.23-alpine AS build
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm exec vite build

FROM nginx:1.29-alpine AS runtime
# Railway PORT beradi; lokal — 80. API_UPSTREAM — API xizmatining ichki manzili.
ENV PORT=80 \
    API_UPSTREAM=http://api:3000
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
